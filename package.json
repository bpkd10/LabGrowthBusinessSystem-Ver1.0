{
  "name": "business-growth-command-center",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "check:syntax": "node --check app/app.js && node --check scripts/*.mjs",
